web/node_modules/
web/.next/
web/out/
web/.env
web/.env.local
web/.env.production

# Database
*.sql.bak
dump.sql
pg_dump/

# Docker
docker/data/
docker/volumes/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
.vscode/
