# ──────────────────────────────────────────────────────────────────────────────
# Masaar CRM — Community Edition
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production
APP_COMPANY_ID=00000000-0000-0000-0000-000000000001

# CORS — set to your frontend domain in production
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
DB_USER=masaar
DB_PASSWORD=change-me-to-strong-password
DB_NAME=masaar
DATABASE_URL=postgres://masaar:change-me-to-strong-password@postgres:5432/masaar?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── WhatsApp Business API (Optional) ─────────────────────────────────────────
# Get credentials from: https://developers.facebook.com/
WA_VERIFY_TOKEN=masaar-webhook-token
WA_API_VERSION=v19.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BASE_URL=https://graph.facebook.com
WA_APP_SECRET=

# ─── Email Service (Optional) ─────────────────────────────────────────────────
# Option 1: SMTP (any provider — Gmail, AWS SES, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=Masaar CRM

# Option 2: Azure Communication Services (takes priority over SMTP if set)
AZURE_COMM_ENDPOINT=
AZURE_COMM_KEY=
AZURE_COMM_FROM_ADDRESS=

# ─── Magic Link Login (Optional) ──────────────────────────────────────────────
MAGIC_LINK_BASE_URL=http://localhost:3000
MAGIC_LINK_EXPIRY_MIN=15
MAGIC_LINK_RATE_LIMIT=3

# ─── SMS OTP Login (Optional — SMSCountry) ────────────────────────────────────
SMSCOUNTRY_ENABLED=false
SMSCOUNTRY_AUTH_KEY=
SMSCOUNTRY_AUTH_TOKEN=
SMSCOUNTRY_SENDER_ID=

# ─── AI / LLM (Optional — Community uses local Ollama only) ───────────────────
# Self-host Ollama for thread summaries and lead scoring.
# Pull a model first: docker exec ollama ollama pull mistral
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# ─── Cloudflare Turnstile (Optional — bot protection on login) ────────────────
# Get keys from: https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_ENABLED=false
FRONTEND_PORT=3000
